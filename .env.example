# Pro frontend
NEXT_PUBLIC_API_URL=https://bookingnail.overpowers.agency
NEXT_PUBLIC_APP_EDITION=pro
NEXT_PUBLIC_ENABLE_CHATBOT=true
NEXT_PUBLIC_ENABLE_SOCIAL_BUBBLES=true
NEXT_PUBLIC_SHOP_LANGUAGE=en
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace_with_google_client_id

# Vi-Tech (build time — Next inlines NEXT_PUBLIC_* into the browser bundle)
NEXT_PUBLIC_VITECH_API_URL=https://api.vi-tech.uk
NEXT_PUBLIC_VITECH_SHOP_SLUG=the-nail-lounge-stokesley
# Public Cloudflare Turnstile site key. Empty renders no challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Basic frontend override
# NEXT_PUBLIC_API_URL=https://bookingnail.basic.overpowers.agency
# NEXT_PUBLIC_APP_EDITION=basic
# NEXT_PUBLIC_ENABLE_CHATBOT=false
# NEXT_PUBLIC_ENABLE_SOCIAL_BUBBLES=false
# NEXT_PUBLIC_SHOP_LANGUAGE=en
